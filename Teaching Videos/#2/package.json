{
    "name": "lightning-css-demo",
    "version": "1.0.0",
    "private": true,
    "scripts": {
      "build": "lightningcss --bundle --minify --targets \">= 0.25%\" css/main.css -o dist/styles.css",
      "watch": "chokidar \"css/**/*.css\" -c \"npm run build\" --debounce 600"
    },
    "devDependencies": {
      "chokidar-cli": "^3.0.0",
      "lightningcss-cli": "^1.33.0"
    }
  }